# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Preferred model configurations
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001

# Vector DB Configuration
CHROMA_PERSIST_DIR=./data/chroma_db

# Server Configuration
HOST=127.0.0.1
PORT=8000

# OpenRouter Free Online Model Configuration (Get free key from https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_CHAT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Ollama Local Configuration (Optional, default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text
